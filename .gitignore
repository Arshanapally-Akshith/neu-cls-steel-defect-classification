# Raw dataset — never commit. Splits are frozen manifests (small CSV/JSON)
# that reference these files by relative path and ARE committed.
NEU-CLS.zip
data/raw/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Models / large artifacts — regenerable from code + data, not committed.
# Metrics/config/plots derived from them still live under reports/ and ARE committed.
models/*.pt
models/*.pth
models/*.h5
models/*.pkl
models/*.joblib

# Exception: the Phase 3 ResNet18 checkpoint IS committed, so the Phase 6
# Streamlit demo can run directly on a fresh clone/deploy without a ~30min
# CPU retraining step first. Every other model artifact stays gitignored.
!models/resnet18_finetuned.pt

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Streamlit — local run artifacts / secrets, never committed. This app
# doesn't use secrets today, but ignore preventively (standard Streamlit
# Community Cloud deployment pattern).
.streamlit/secrets.toml
